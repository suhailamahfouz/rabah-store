# Copy to .env — never commit .env
NODE_ENV=development
PORT=4000
# MongoDB Atlas connection string (create a DB user with readWrite on the rabah database)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rabah?retryWrites=true&w=majority
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated allowed browser origins
CLIENT_ORIGIN=http://localhost:4200
# Canonical public storefront origin. In production set your HTTPS store domain.
# Defaults to the first CLIENT_ORIGIN when omitted.
SITE_URL=http://localhost:4200
# true in production (HTTPS). Cookies are HttpOnly regardless.
COOKIE_SECURE=false
# 'lax' for same-site deploys; 'none' (+COOKIE_SECURE=true) if client and API are on different sites
COOKIE_SAMESITE=lax
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50
# Required for dashboard image uploads. Copy the three real values from
# Cloudinary Console > Settings > API Keys; never expose them in the client.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
